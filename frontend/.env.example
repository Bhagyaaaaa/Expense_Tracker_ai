# Only needed if your backend isn't running on the default http://localhost:5000/api
# Copy to .env and uncomment if needed.
# VITE_API_URL=http://localhost:5000/api
# Copy this file to .env and fill in real values. Never commit the real .env file.

# Port the Express server runs on
PORT=5000

# A long random string used to sign login tokens (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=Hi_im_doing_full_stack_project_here

# Get a free key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
